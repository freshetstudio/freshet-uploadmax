#. Plugin Name of the plugin
#: freshet-uploadmax.php
msgid "Freshet Upload Max"
msgstr ""

#. Description of the plugin
#: freshet-uploadmax.php
msgid "Raises the WordPress upload size limit (default 64MB) without editing server config, by writing a managed .user.ini or .htaccess block. Overridable via a wp-config constant or env var."
msgstr ""

#. Author of the plugin
#: freshet-uploadmax.php
msgid "Freshet Studio"
msgstr ""

#. Author URI of the plugin
#: freshet-uploadmax.php
msgid "https://freshet.studio"
msgstr ""

#. translators: %s: absolute path(s) to the file(s) still holding the block.
#: freshet-uploadmax.php:830
#, php-format
msgid "Freshet Upload Max couldn't remove its managed block from %s. Delete the block between the BEGIN/END Freshet Upload Max markers by hand, or the raised limit stays in place."
msgstr ""

#. translators: %s: absolute path to the WordPress root.
#: freshet-uploadmax.php:844
#, php-format
msgid "Freshet Upload Max couldn't write to %s. Make the WordPress root writable, or set the upload limit in your server config."
msgstr ""

#: freshet-uploadmax.php:849
msgid "Freshet Upload Max couldn't find a supported way to raise the limit on this host (FastCGI/FPM with .user.ini enabled, or mod_php), so it left the upload limit unchanged. Raise it in your server config instead."
msgstr ""

#: freshet-uploadmax.php:852
msgid "Freshet Upload Max's .htaccess directives are rejected by your server (usually a restrictive AllowOverride), so the change was not applied — your site stays online. Raise the upload limit in your server config instead."
msgstr ""

#: freshet-uploadmax.php:855
msgid "Freshet Upload Max writes one shared, network-wide upload limit on multisite, so it needs a network administrator. Ask a network admin to activate it network-wide, or raise the limit in your server config."
msgstr ""

#. translators: %s: absolute path to the .htaccess file.
#: freshet-uploadmax.php:860
#, php-format
msgid "Freshet Upload Max's .htaccess directives were rejected by your server and the previous %s could not be restored. Remove the block between the BEGIN/END Freshet Upload Max markers by hand — the site may be returning errors until you do."
msgstr ""

#: freshet-uploadmax.php:865
msgid "Freshet Upload Max wrote the config, but the upload limit hasn't increased — your host may ignore .user.ini or enforce a lower hard cap. Raise it in your server config instead."
msgstr ""
